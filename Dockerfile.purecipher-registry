FROM ghcr.io/astral-sh/uv:0.12.5 AS uv
FROM node:24-bookworm-slim AS node
FROM docker:28-cli AS docker-cli

FROM python:3.12-slim-bookworm AS build
COPY --from=uv /uv /uvx /usr/local/bin/
WORKDIR /build
COPY pyproject.toml uv.lock README.md LICENSE ./
COPY src ./src
COPY fastmcp_slim ./fastmcp_slim
COPY fastmcp_remote ./fastmcp_remote
COPY fastmcp_tasks ./fastmcp_tasks

# CI passes the version read from the tested wheels. Local source builds use
# 0.0.0 unless PACKAGE_VERSION is supplied; no Git credentials enter the image.
ARG PACKAGE_VERSION=0.0.0
RUN UV_DYNAMIC_VERSIONING_BYPASS="$PACKAGE_VERSION" \
    uv build --all-packages --wheel --out-dir /wheels
RUN uv export --frozen --no-dev --all-packages --no-emit-workspace \
    --no-hashes --no-header --no-annotate --output-file /wheels/constraints.txt

FROM python:3.12-slim-bookworm AS runtime
ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    UV_LINK_MODE=copy
WORKDIR /app

# Keep the npm, PyPI, and Docker launchers used by registry introspection.
# The Docker daemon, if needed, is supplied by the deployment separately.
COPY --from=uv /uv /uvx /usr/local/bin/
COPY --from=node /usr/local/bin/node /usr/local/bin/node
COPY --from=node /usr/local/lib/node_modules/npm /usr/local/lib/node_modules/npm
COPY --from=docker-cli /usr/local/bin/docker /usr/local/bin/docker
RUN ln -s ../lib/node_modules/npm/bin/npm-cli.js /usr/local/bin/npm \
    && ln -s ../lib/node_modules/npm/bin/npx-cli.js /usr/local/bin/npx

COPY --from=build /wheels /tmp/wheels
RUN uv pip install --system --no-cache --constraint /tmp/wheels/constraints.txt /tmp/wheels/*.whl \
    && rm -rf /tmp/wheels \
    && node --version && npx --version && uv --version && uvx --version && docker --version

EXPOSE 8000
# Supply DATABASE_URL for durable PostgreSQL storage. Without it the registry
# uses ephemeral storage. Set PURECIPHER_SIGNING_SECRET at deployment time.
CMD ["purecipher-registry", "--host", "0.0.0.0", "--port", "8000"]
